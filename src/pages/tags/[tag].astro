---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import Profile from "../../components/Profile.astro";
import Sidebar from "../../components/Sidebar.astro";
import { tagToSlug } from "../../utils/tag";

export async function getStaticPaths() {
    const allPosts = await getCollection("blog");
    const allTags = [
        ...new Set(allPosts.map((p) => p.data.tags).flat()),
    ].sort();
    const uniqueTags = [
        ...new Set(allPosts.map((post) => post.data.tags).flat()),
    ];
    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) =>
            post.data.tags.includes(tag),
        );
        return {
            params: { tag: tagToSlug(tag) },
            props: { posts: filteredPosts, allPosts, allTags, originalTag: tag },
        };
    });
}

const { tag } = Astro.params;
const { posts, allPosts, allTags, originalTag } = Astro.props;
---

<BaseLayout pageTitle={originalTag}>
    <Profile />
    <div class="main">
        <section>
            <h2 class="section-title">#{originalTag}（共 {posts.length} 篇文章）</h2>
            <ul class="post-list">
                {
                    posts.map((post) => (
                        <BlogPost
                            url={`/posts/${post.id}/`}
                            title={post.data.title}
                            date={post.data.pubDate}
                            description={post.data.description}
                            tags={post.data.tags}
                        />
                    ))
                }
            </ul>
        </section>

        <Sidebar {allPosts} {allTags} />
    </div>
</BaseLayout>

<style>
    .main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--space-lg) var(--space-2xl);
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: var(--space-xl);
    }
    .main > section {
        min-width: 0;
    }
    .section-title {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text-secondary);
        margin-bottom: var(--space-lg);
        padding-bottom: var(--space-sm);
        border-bottom: 1px solid var(--color-border);
    }
    .post-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        padding: 0;
        margin: 0;
    }
    @media (max-width: 768px) {
        .main {
            grid-template-columns: 1fr;
        }
    }
</style>
