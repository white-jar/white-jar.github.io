---
import { getCollection } from "astro:content";
import BaseLayout from '../layouts/BaseLayout.astro';
import Profile from '../components/Profile.astro';
import Sidebar from '../components/Sidebar.astro';
import PostTimelineList from '../components/PostTimelineList.astro';

const allPosts = await getCollection('blog');

const allTags = [...new Set(allPosts.map(p => p.data.tags).flat())].sort();
---
<BaseLayout pageTitle="所有文章">
  <Profile
    name="純白罐子"
    subtitle="州・Kevin"
    bio="我將邏輯與演算法投入罐子, 碎片化的程式碼以滴漏方式逐步加入, 以思緒做攪拌捧徐徐的攪拌, 以舊日情懷激情的溫度進行催化, 罐子中進行一連串的化學反應, 當胸口熱情的溫度逐漸降到常溫, 拿出濾紙過濾, 竟然萃取出一堆的 bug。"
    tags={["C#", "Web", "AI", "Arduino", "Raspberry Pi", "音響改裝"]}
  />
  <div class="main">
    <section>
      <h2 class="section-title">所有文章</h2>
      <PostTimelineList posts={allPosts} accordion={true} />
    </section>

    <Sidebar {allPosts} {allTags} />
  </div>
</BaseLayout>

<style>
  .main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-lg) var(--space-2xl);
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-xl);
  }

  .section-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .main { grid-template-columns: 1fr; }
  }
</style>
