---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import Profile from "../../components/Profile.astro";
import Sidebar from "../../components/Sidebar.astro";
import { tagToSlug } from "../../utils/tag";

export async function getStaticPaths() {
    const allPosts = await getCollection("blog");
    const allTags = [
        ...new Set(allPosts.map((p) => p.data.tags).flat()),
    ].sort();
    const uniqueTags = [
        ...new Set(allPosts.map((post) => post.data.tags).flat()),
    ];
    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) =>
            post.data.tags.includes(tag),
        );
        return {
            params: { tag: tagToSlug(tag) },
            props: { posts: filteredPosts, allPosts, allTags, originalTag: tag },
        };
    });
}

const { tag } = Astro.params;
const { posts, allPosts, allTags, originalTag } = Astro.props;
---

<BaseLayout pageTitle={originalTag}>
    <Profile
        name="純白罐子"
        subtitle="州・Kevin"
        bio="我將邏輯與演算法投入罐子, 碎片化的程式碼以滴漏方式逐步加入, 以思緒做攪拌捧徐徐的攪拌, 以舊日情懷激情的溫度進行催化, 罐子中進行一連串的化學反應, 當胸口熱情的溫度逐漸降到常溫, 拿出濾紙過濾, 竟然萃取出一堆的 bug。"
        tags={["C#", "Web", "AI", "Arduino", "Raspberry Pi", "音響改裝"]}
    />
    <div class="main">
        <section>
            <h2 class="section-title">#{originalTag}（共 {posts.length} 篇文章）</h2>
            <ul class="post-list">
                {
                    posts.map((post) => (
                        <BlogPost
                            url={`/posts/${post.id}/`}
                            title={post.data.title}
                            date={post.data.pubDate}
                            description={post.data.description}
                            tags={post.data.tags}
                        />
                    ))
                }
            </ul>
        </section>

        <Sidebar {allPosts} {allTags} />
    </div>
</BaseLayout>

<style>
    .main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--space-lg) var(--space-2xl);
        display: grid;
        grid-template-columns: 1fr 280px;
        gap: var(--space-xl);
    }
    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--color-text);
        margin-bottom: var(--space-lg);
        padding-bottom: var(--space-sm);
        border-bottom: 2px solid var(--color-accent-muted);
    }
    .post-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
        padding: 0;
        margin: 0;
    }
    @media (max-width: 768px) {
        .main {
            grid-template-columns: 1fr;
        }
    }
</style>
